@model IEnumerable<CrudApp.Models.StudentModel>

@{
    ViewBag.Title = "Deleted Students";
    double currentPage = ViewBag.CurrentPage;
    double totalPages = ViewBag.TotalPages;
}

<h2 class="text-center my-4 text-secondary">Deleted Students</h2>
<div class="d-flex justify-content-between mb-4">
    <div class="mb-3 text-secondary">
        <a href="@Url.Action("Show")" class="btn btn-outline-secondary rounded-pill px-4 py-2">Back</a>
    </div>

    <div>
        <button id="printButton" class="btn btn-secondary shadow-sm rounded-pill me-2">
            <i class="fas fa-print me-2"></i> Print
        </button>
        <button id="exportButton" class="btn btn-secondary shadow-sm rounded-pill">
            <i class="fas fa-download me-2"></i> Download Excel
        </button>
    </div>

</div>

<style>
    .hidden-column {
        display: none;
    }
</style>

    <table id="studentsTable" class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Serial</th>
                <th class="hidden-column">@Html.DisplayNameFor(model => model.StudentId)</th>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.RollNo)</th>
                <th>@Html.DisplayNameFor(model => model.Department)</th>
                <th>Age</th>
                <th>@Html.DisplayNameFor(model => model.Gender)</th>
                <th>@Html.DisplayNameFor(model => model.Address)</th>
                <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td> @ViewBag.c</td>
                    <td class="hidden-column">@Html.DisplayFor(modelItem => item.StudentId)</td>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.RollNo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Department)</td>
                    <td>@(DateTime.Now.Subtract(item.DateOfBirth).Days / 365)</td>
                    <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                    <td>@Html.DisplayFor(modelItem => item.Address)</td>
                    <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                    <td class="d-flex justify-content-center align-items-center">
                        <a class="btn btn-sm btn-secondary shadow-sm rounded-pill text-white me-2" href="@Url.Action("Restore", new { id = item.StudentId })">
                            <i class="fas fa-undo"></i>
                        </a>
                        <a class="btn btn-sm btn-secondary shadow-sm rounded-pill text-white me-2" href="@Url.Action("Delete","Students", new { id = item.StudentId })" aria-label="Delete Student">
                            <i class="fas fa-trash-alt"></i>
                        </a>

                    </td>
                    @{
                        ViewBag.c = ViewBag.c + 1;
                    }
                </tr>
            }
        </tbody>
    </table>
    @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />

        <script>
            function toggleActionsColumn(show) {
                const actionColumnIndex = 4;
                $("#studentsTable tr").each(function () {
                    $(this).find("td:eq(" + actionColumnIndex + "), th:eq(" + actionColumnIndex + ")")
                        .toggle(show);
                });
            }

            $("#printButton").click(function () {
                toggleActionsColumn(false);

                var printContents = document.getElementById('studentsTable').outerHTML;
                var originalContents = document.body.innerHTML;

                document.body.innerHTML = "<h2>Student List</h2>" + printContents;
                window.print();

                document.body.innerHTML = originalContents;
                location.reload();
            });

            $("#exportButton").click(function () {
                toggleActionsColumn(false);

                var table = document.getElementById('studentsTable').cloneNode(true);
                var rows = table.querySelectorAll('tr');
                rows.forEach(row => {
                    if (row.lastElementChild) {
                        row.removeChild(row.lastElementChild);
                    }
                });
                var workbook = XLSX.utils.table_to_book(table, { sheet: "Students" });
                XLSX.writeFile(workbook, 'Students.xlsx');

                toggleActionsColumn(true);
            });
        </script>
    }
