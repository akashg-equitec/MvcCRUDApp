@model IEnumerable<CrudApp.Models.StudentModel>

@{
    ViewBag.Title = "Show";
    double currentPage = ViewBag.CurrentPage;
    double totalPages = ViewBag.TotalPages;
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <script>
        setTimeout(function () {
            var successAlert = document.getElementById("successAlert");
            if (successAlert) {
                successAlert.classList.remove("show");
                successAlert.style.display = "none";
            }
        }, 1000); // 3000ms = 3 seconds
    </script>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2 class="text-center my-4 text-secondary shadow-sm rounded-pill">Student List</h2>

<div class="d-flex justify-content-between mb-4">
    <div>
        <a class="btn btn-secondary shadow-sm rounded-pill me-2" href="@Url.Action("Create")">
            <i class="fas fa-plus me-2"></i> Create New
        </a>
        <a class="btn btn-secondary shadow-sm rounded-pill" href="@Url.Action("DeletedView")">
            <i class="fas fa-trash-restore me-2"></i> View Deleted
        </a>
    </div>
    <div>
        <button id="printButton" class="btn btn-secondary shadow-sm rounded-pill me-2">
            <i class="fas fa-print me-2"></i> Print
        </button>
        <button id="exportButton" class="btn btn-secondary shadow-sm rounded-pill">
            <i class="fas fa-download me-2"></i> Download Excel
        </button>
    </div>
</div>

<head>
    <style>
        .hidden-column {
            display: none;
        }

        @@media print {
            .action-column {
                display: none !important;
            }

                .action-column * {
                    display: none !important;
                }
        }

        .d-flex {
            display: flex;
        }

        .justify-content-between {
            justify-content: space-between;
        }

        .align-items-center {
            align-items: center;
        }

        .sort-btn {
            padding: 0;
            margin-left: 5px;
            color: black; /* Adjust color if needed */
            border: none;
            cursor: pointer;
        }

            .sort-btn:hover {
                color: black;
            }

        th {
            white-space: nowrap;
        }
    </style>
</head>



  
<div class="d-flex justify-content-start mb-4">
    <div class="me-2">
        <input type="text" id="searchBar" class="form-control shadow-sm rounded-pill" placeholder="Search by Name" value="@Request.QueryString["searchQuery"]" />
    </div>
    <div class="me-2">
        <select id="departmentDropdown" class="form-control shadow-sm rounded-pill">
            <option value="">Select Department</option>
            @foreach (var dept in ViewBag.Dept as List<CrudApp.Models.StudentModel>)
            {
                <option value="@dept.DepartmentName" @(dept.DepartmentName == Request.QueryString["selectedDepartment"] ? "selected" : "")>@dept.DepartmentName</option>
            }
        </select>
    </div>
    <button id="filterButton" class="btn btn-secondary shadow-sm rounded-pill" type="button">
        <i class="fas fa-search me-2"></i> Search
    </button>
</div>




<script>
       // Filter functionality
function filterResults() {
    const searchQuery = $("#searchBar").val();
    const selectedDepartment = $("#departmentDropdown").val();

    console.log("Search Query: ", searchQuery);
    console.log("Selected Department: ", selectedDepartment);

    // Reload the page with query parameters
    window.location.href = '@Url.Action("Show")?searchQuery=' + searchQuery + '&selectedDepartment=' + selectedDepartment;
}



    $(document).ready(function () {
        // Ensure that the button click event is correctly bound
        $("#filterButton").on("click", function () {
            console.log("Search button clicked.");  // Check if the button is clicked
            filterResults();
        });

        // Trigger filter when Enter is pressed in search bar
        $("#searchBar").on("keypress", function (e) {
            if (e.which === 13) {
                console.log("Enter key pressed."); // Check if Enter key is being pressed
                filterResults();
            }
        });

        // Trigger filter when department is changed
        $("#departmentDropdown").on("change", function () {
            console.log("Department changed.");  // Check if department is changed
            filterResults();
        });
    });

// Trigger filter when department is changed
$("#departmentDropdown").on("change", function () {
    filterResults();
});

</script>






<table id="studentsTable" class="table table-bordered table-striped shadow-sm rounded-pill">
    <thead class="table-lgrey">
        <tr class="text-secondary shadow-sm rounded-pill text-center">
            <th>
                <div class="d-flex justify-content-between align-items-center">
                    <span>SRno.</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none sort-btn" data-column="0" data-order="desc">⇩</button>
                </div>
            </th>
            <th class="hidden-column">
                <div class="d-flex justify-content-between align-items-center">
                    <span>@Html.DisplayNameFor(model => model.StudentId)</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none sort-btn hidden-column" data-column="1" data-order="desc">⇩</button>
                </div>
            </th>
            <th>
                <div class="d-flex justify-content-between align-items-center">
                    <span>@Html.DisplayNameFor(model => model.Name)</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none sort-btn" data-column="2" data-order="desc">⇩</button>
                </div>
            </th>
            <th>
                <div class="d-flex justify-content-between align-items-center">
                    <span>@Html.DisplayNameFor(model => model.RollNo)</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none sort-btn" data-column="3" data-order="desc">⇩</button>
                </div>
            </th>
            <th>
                <div class="d-flex justify-content-between align-items-center">
                    <span>@Html.DisplayNameFor(model => model.Department)</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none sort-btn" data-column="4" data-order="desc">⇩</button>
                </div>
            </th>
            <th>
                <div class="d-flex justify-content-between align-items-center">
                    <span>Age</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none sort-btn" data-column="5" data-order="desc">⇩</button>
                </div>
            </th>
            <th>
                <div class="d-flex justify-content-between align-items-center">
                    <span>@Html.DisplayNameFor(model => model.Gender)</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none sort-btn" data-column="6" data-order="desc">⇩</button>
                </div>
            </th>
            <th>
                <div class="d-flex justify-content-between align-items-center">
                    <span>@Html.DisplayNameFor(model => model.Address)</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none sort-btn" data-column="7" data-order="desc">⇩</button>
                </div>
            </th>
            <th>
                <div class="d-flex justify-content-between align-items-center">
                    <span>@Html.DisplayNameFor(model => model.PhoneNumber)</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none sort-btn" data-column="8" data-order="desc">⇩</button>
                </div>
            </th>
            <th class="action-column">Actions</th>
        </tr>
    </thead>


    <tbody>
        @foreach (var item in Model)
        {
            <tr class="text-center">
                <td>@ViewBag.c</td>
                <td class="hidden-column">@Html.DisplayFor(modelItem => item.StudentId)</td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.RollNo)</td>
                <td>@Html.DisplayFor(modelItem => item.Department)</td>
                <td>@(DateTime.Now.Subtract(item.DateOfBirth).Days / 365)</td>
                <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                <td class="d-flex justify-content-center align-items-center">
                    @if (item.StudentId != null)
                    {
                        <a class="btn btn-sm btn-secondary shadow-sm rounded-pill text-white me-2" href="@Url.Action("Update", "Students", new { StudentId = item.StudentId })" aria-label="Edit Student">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a class="btn btn-sm btn-secondary shadow-sm rounded-pill text-white me-2" href="@Url.Action("Details", new { id = item.StudentId })" aria-label="View Details">
                            <i class="fas fa-info-circle"></i>
                        </a>
                        <a class="btn btn-sm btn-secondary shadow-sm rounded-pill text-white me-2" href="@Url.Action("SoftDelete", new { id = item.StudentId })" aria-label="Delete Student">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    }
                </td>
                @{
                    ViewBag.c = ViewBag.c + 1;
                }
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <ul class="pagination justify-content-center text-secondary">
        @if (currentPage > 1)
        {
            <li class="page-item">
                @Html.ActionLink("Previous", "Show", new { page = currentPage - 1 }, new { @class = "page-link rounded-pill text-secondary" })
            </li>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == currentPage ? "bg-secondary text-white" : "")">
                @Html.ActionLink(i.ToString(), "Show", new { page = i }, new { @class = "page-link rounded-pill text-secondary" })
            </li>
        }

        @if (currentPage < totalPages)
        {
            <li class="page-item">
                @Html.ActionLink("Next", "Show", new { page = currentPage + 1 }, new { @class = "page-link rounded-pill text-secondary" })
            </li>
        }
    </ul>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            $(".sort-btn").on("click", function () {
                const table = $("#studentsTable");
                const rows = table.find("tbody > tr").toArray();
                const column = $(this).data("column");
                const order = $(this).data("order");

                rows.sort((a, b) => {
                    const cellA = $(a).find("td").eq(column).text().trim();
                    const cellB = $(b).find("td").eq(column).text().trim();

                    if ($.isNumeric(cellA) && $.isNumeric(cellB)) {
                        return order === "desc" ? cellB - cellA : cellA - cellB;
                    }
                    return order === "desc"
                        ? cellB.localeCompare(cellA)
                        : cellA.localeCompare(cellB);
                });

                // Append sorted rows back to the table
                table.find("tbody").append(rows);

                // Toggle sorting order for the next click
                $(this).data("order", order === "desc" ? "asc" : "desc");
                $(this).text(order === "desc" ? "⇧" : "⇩");
            });
        });
    </script>

    <script>
        function toggleActionsColumn(show) {
            const actionColumnIndex = 4;
            $("#studentsTable tr").each(function () {
                $(this).find("td:eq(" + actionColumnIndex + "), th:eq(" + actionColumnIndex + ")")
                    .toggle(show);
            });
        }

        $("#printButton").click(function () {
            toggleActionsColumn(false);

            var printContents = document.getElementById('studentsTable').outerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = "<h2>Student List</h2>" + printContents;
            window.print();

            document.body.innerHTML = originalContents;
            location.reload();
        });

        $("#exportButton").click(function () {
            toggleActionsColumn(false);

            var table = document.getElementById('studentsTable').cloneNode(true);
            var rows = table.querySelectorAll('tr');
            rows.forEach(row => {
                if (row.lastElementChild) {
                    row.removeChild(row.lastElementChild);
                }
            });
            var workbook = XLSX.utils.table_to_book(table, { sheet: "Students" });
            XLSX.writeFile(workbook, 'Students.xlsx');

            toggleActionsColumn(true);
        });
    </script>
}
